# ---------------------------------------------------------------------------
# Bluetooth Proximity Advertising Platform - web application
# Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bluetooth_ads?schema=public"

# Auth.js - generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
# Public base URL of the dashboard (used by Auth.js and for absolute media URLs)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# Secret used to HMAC anonymous mobile device tokens before storage.
# Changing it breaks frequency capping continuity for existing devices.
DEVICE_TOKEN_SECRET="replace-with-another-long-random-secret"

# Shared API key the mobile app sends in the `x-api-key` header.
# Treat as an abuse deterrent only - keys embedded in apps can be extracted.
MOBILE_API_KEY="replace-with-mobile-api-key"

# Allow the Bluetooth SIG test company identifier 0xFFFF when no company ID is configured.
# Development/testing ONLY. Must be false in production.
ALLOW_TEST_COMPANY_ID=true

# Trust X-Forwarded-For for client IPs (set true only behind a trusted reverse proxy).
TRUST_PROXY=false

# Rate limits for mobile endpoints (per client IP, per minute)
MOBILE_EVENTS_RATE_LIMIT_PER_MINUTE=60
MOBILE_CAMPAIGNS_RATE_LIMIT_PER_MINUTE=120

# Media storage: "local" (files under STORAGE_LOCAL_DIR) or "s3" (DigitalOcean Spaces / S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
MAX_UPLOAD_BYTES=2097152

# Required when STORAGE_DRIVER=s3
S3_ENDPOINT="https://sgp1.digitaloceanspaces.com"
S3_REGION="sgp1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for objects, e.g. https://<bucket>.sgp1.cdn.digitaloceanspaces.com
S3_PUBLIC_BASE_URL=""

# Seed configuration (npm run db:seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
# Set to false to seed only the admin user and settings (no sample campaigns/stations/events)
SEED_SAMPLE_DATA=true
